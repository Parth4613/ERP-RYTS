{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (with Supabase defines)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=SUPABASE_URL=https://<PROJECT>.supabase.co",
        "--dart-define=SUPABASE_ANON_KEY=<PUBLIC_ANON_KEY>"
      ]
    }
  ]
}
